{
  "info": { "name": "S11 - Orders API (TC-01 a TC-14)", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Colección automatizada; cada request y prueba está identificado con la matriz." },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.request.headers.add({key:'Accept',value:'application/json'});"] } }],
  "item": [
    { "name": "TC-01 Health", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-01 status 200',()=>pm.response.to.have.status(200));", "const j=pm.response.json(); pm.test('TC-01 esquema health',()=>pm.expect(j).to.have.all.keys('status','service','version')); pm.expect(j.status).to.eql('ok');"] } }] },
    { "name": "TC-02 Login Alice", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"username\":\"alice\",\"password\":\"Alice123!\"}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-02 status 200',()=>pm.response.to.have.status(200));", "const j=pm.response.json(); pm.expect(j.token).to.be.a('string'); pm.expect(j.user.username).to.eql('alice'); pm.environment.set('aliceToken',j.token);"] } }] },
    { "name": "TC-03 Paginación", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }], "url": "{{baseUrl}}/orders?page=1&pageSize=1" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-03 status 200',()=>pm.response.to.have.status(200));", "const j=pm.response.json(); pm.expect(j.data).to.be.an('array').with.lengthOf.at.most(1); pm.expect(j.pagination.page).to.eql(1); pm.expect(j.pagination.pageSize).to.eql(1); pm.expect(j.pagination.total).to.be.a('number');"] } }] },
    { "name": "TC-04 Crear pedido", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"product\":\"Audífonos S11\",\"quantity\":2}" }, "url": "{{baseUrl}}/orders" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-04 status 201',()=>pm.response.to.have.status(201));", "const j=pm.response.json(); pm.expect(j.id).to.match(/^ord-/); pm.expect(j.owner).to.eql('me'); pm.environment.set('orderId',j.id);"] } }] },
    { "name": "TC-05 Consultar pedido creado", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }], "url": "{{baseUrl}}/orders/{{orderId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-05 status 200',()=>pm.response.to.have.status(200));", "pm.expect(pm.response.json().id).to.eql(pm.environment.get('orderId')); pm.expect(pm.response.json().product).to.eql('Audífonos S11');"] } }] },
    { "name": "TC-06 Cambiar estado", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"confirmed\"}" }, "url": "{{baseUrl}}/orders/{{orderId}}/status" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-06 status 200',()=>pm.response.to.have.status(200)); pm.expect(pm.response.json().status).to.eql('confirmed');"] } }] },
    { "name": "TC-07 Idempotencia repetir estado", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"confirmed\"}" }, "url": "{{baseUrl}}/orders/{{orderId}}/status" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-07 status 200',()=>pm.response.to.have.status(200)); const j=pm.response.json(); pm.expect(j.id).to.eql(pm.environment.get('orderId')); pm.expect(j.status).to.eql('confirmed'); pm.environment.set('idempotentStatus',j.status);"] } }] },
    { "name": "TC-08 Obligatorio ausente", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"quantity\":1}" }, "url": "{{baseUrl}}/orders" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-08 status 422',()=>pm.response.to.have.status(422)); const j=pm.response.json(); pm.expect(j.error.code).to.eql('VALIDATION_ERROR'); pm.expect(j.error.details.join(' ')).to.include('product');"] } }] },
    { "name": "TC-09 Tipo inválido", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"product\":\"X\",\"quantity\":0}" }, "url": "{{baseUrl}}/orders" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-09 status 422',()=>pm.response.to.have.status(422)); pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');"] } }] },
    { "name": "TC-10 Sin credenciales", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-10 status 401',()=>pm.response.to.have.status(401)); pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');"] } }] },
    { "name": "TC-11 Token inválido", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer invalid-token" }], "url": "{{baseUrl}}/orders" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-11 status 401',()=>pm.response.to.have.status(401)); pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');"] } }] },
    { "name": "TC-12 Recurso ajeno", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }], "url": "{{baseUrl}}/orders/{{foreignOrderId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-12 status 403',()=>pm.response.to.have.status(403)); pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');"] } }] },
    { "name": "TC-13 Recurso inexistente", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }], "url": "{{baseUrl}}/orders/ord-no-existe" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-13 status 404',()=>pm.response.to.have.status(404)); pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');"] } }] },
    { "name": "TC-14 Paginación inválida", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }], "url": "{{baseUrl}}/orders?page=abc&pageSize=1" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('TC-14 status 400',()=>pm.response.to.have.status(400)); pm.expect(pm.response.json().error.code).to.eql('INVALID_PAGINATION');"] } }] }
  ]
}
